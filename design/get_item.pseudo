# Project One Get-Item Pseudocode

START get_item

    # TODO 1: Information the get-item process needs

    SET room_items to a dictionary of each room and its item:
        Lobby: none
        Security Office: Access Badge
        Records Room: Network Log
        Break Room: Fingerprint Kit
        Forensics Lab: Encrypted Laptop
        Evidence Locker: Flash Drive
        Supply Closet: Decryption Key
        Server Room: none

    # current_room, inventory, and command come from the main game loop
    # (see move.pseudo)

    # TODO 2: Receive the player's get-item command

    # The main loop already prompted the player and received the command,
    # for example "get Flash Drive"
    SET requested_item to the text after "get ", trimmed

    # TODO 3: Validate that the item is in the current room

    IF requested_item is empty
        # TODO 5: Invalid request (no item named)
        OUTPUT "Specify an item, for example 'get Access Badge'."

    ELSE IF room_items[current_room] is not none AND
            requested_item matches room_items[current_room], ignoring capitalization

        IF room_items[current_room] is in inventory
            OUTPUT "You already have the " + room_items[current_room] + "."

        ELSE
            # TODO 4: Valid request
            ADD room_items[current_room] to inventory
            OUTPUT "You picked up the " + room_items[current_room] + "."
            OUTPUT "Items collected: " + number of items in inventory + " of 6"
        END IF

    ELSE
        # TODO 5: Invalid request (item not in this room)
        OUTPUT "There is no " + requested_item + " in the " + current_room + "."
    END IF

    # TODO 6: Return to the gameplay loop

    # Picking up an item never ends the game. Control returns to the WHILE loop
    # in move.pseudo, which displays the room and inventory and asks for the next command.

END get_item


